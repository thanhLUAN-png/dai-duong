@model WebApplication1.ViewModels.LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; }
<main class="account-page"><a class="brand account-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">◒</span> biển của chúng mình</a><section class="account-card"><p class="eyebrow">Chào mừng trở lại</p><h1>Vào xưởng vẽ</h1><form method="post"><div asp-validation-summary="ModelOnly" class="validation"></div><label>Email<input asp-for="Email" placeholder="ban@email.com" /></label><label>Mật khẩu<input asp-for="Password" placeholder="••••••••" /></label><button class="primary-button" type="submit">Đăng nhập <span>→</span></button></form><p>Chưa có tài khoản? <a asp-action="Register">Tạo tài khoản</a></p></section></main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
