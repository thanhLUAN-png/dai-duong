@model WebApplication1.ViewModels.RegisterViewModel
@{ ViewData["Title"] = "Tạo tài khoản"; }
<main class="account-page">
    <div class="account-bubbles" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
    <a class="brand account-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">🐟</span> Biển Của Chúng Mình</a>
    <section class="account-card">
        <div class="account-icon">🪼</div><p class="eyebrow">Bắt đầu hành trình</p><h1>Tham gia cùng chúng mình!</h1><p class="account-lead">Tạo tài khoản để vẽ và thả cá vào đại dương chung.</p>
        <form method="post"><div asp-validation-summary="ModelOnly" class="validation"></div><label>Tên hiển thị<input asp-for="DisplayName" placeholder="Tên của bạn" /></label><label>Email<input asp-for="Email" placeholder="ban@email.com" /></label><label>Mật khẩu<input asp-for="Password" placeholder="Ít nhất 6 ký tự" /></label><button class="primary-button account-coral" type="submit">🐟 Tạo tài khoản &amp; vào Xưởng vẽ</button></form>
        <p>Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p>
    </section>
</main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
