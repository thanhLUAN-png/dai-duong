@model WebApplication1.Models.CreatureTemplate
@{ ViewData["Title"] = "Tô màu " + Model.Name; }
<main class="color-page"><nav class="studio-nav"><a class="brand" asp-action="Index"><span class="brand-mark">←</span> trở về xưởng vẽ</a><span class="color-title">@Model.Name</span></nav><section class="color-layout"><aside class="toolbox"><p class="eyebrow">Bảng màu</p><div class="palette"><button data-color="#ef7658" style="background:#ef7658"></button><button data-color="#f5c968" style="background:#f5c968"></button><button data-color="#8ad6cf" style="background:#8ad6cf"></button><button data-color="#4879bb" style="background:#4879bb"></button><button data-color="#bc8abd" style="background:#bc8abd"></button><button data-color="#254c66" style="background:#254c66"></button></div><label class="brush-label">Cỡ cọ <input id="brushSize" type="range" min="4" max="40" value="14" /></label><button id="undoButton" class="tool-button">↶ Hoàn tác</button><button id="redoButton" class="tool-button">↷ Làm lại</button><button id="eraserButton" class="tool-button">⌫ Tẩy</button><button id="resetButton" class="tool-button danger">Làm lại từ đầu</button></aside><section class="drawing-area"><div class="canvas-wrap"><canvas id="colorCanvas" width="860" height="580" data-type="@Model.Type" data-template-image="@Model.OutlineImagePath"></canvas></div><form id="submissionForm" asp-action="Submit" method="post"><input type="hidden" name="templateId" value="@Model.Id" /><input type="hidden" name="imageData" id="imageData" /><input class="art-title" name="title" maxlength="120" placeholder="Đặt tên cho tác phẩm (không bắt buộc)" /><button class="primary-button" type="submit">Gửi để duyệt <span>↑</span></button></form></section></section></main>
