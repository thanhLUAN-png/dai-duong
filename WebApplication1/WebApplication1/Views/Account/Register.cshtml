@model WebApplication1.ViewModels.RegisterViewModel
@{ ViewData["Title"] = "Tạo tài khoản"; }
<main class="account-page"><a class="brand account-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">◒</span> biển của chúng mình</a><section class="account-card"><p class="eyebrow">Bắt đầu hành trình</p><h1>Tạo tài khoản</h1><form method="post"><div asp-validation-summary="ModelOnly" class="validation"></div><label>Tên hiển thị<input asp-for="DisplayName" placeholder="Tên của bạn" /></label><label>Email<input asp-for="Email" placeholder="ban@email.com" /></label><label>Mật khẩu<input asp-for="Password" placeholder="Ít nhất 6 ký tự" /></label><button class="primary-button" type="submit">Tạo tài khoản <span>→</span></button></form><p>Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p></section></main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
