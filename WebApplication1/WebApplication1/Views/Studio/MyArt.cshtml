@model IEnumerable<WebApplication1.Models.ArtworkSubmission>
@{
    ViewData["Title"] = "Tác phẩm của tôi";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var userName = User.Identity?.Name ?? "bạn";
    var artList  = Model.ToList();
}

<script src="https://cdn.tailwindcss.com"></script>
<style>
  @@import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap');
  * { box-sizing: border-box; }
  body { font-family: 'Nunito', sans-serif; margin: 0; }

  @@keyframes bubble-rise {
    0%   { transform: translateY(0) scale(1);   opacity: 0.7; }
    100% { transform: translateY(-110vh) scale(1.2); opacity: 0; }
  }
  @@keyframes wave-anim {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  @@keyframes fade-up {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @@keyframes float-anim {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-12px); }
  }
  @@keyframes card-float {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-6px); }
  }

  .bubble {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, rgba(255,255,255,0.9), rgba(180,230,255,0.3));
    border: 1px solid rgba(255,255,255,0.6);
    animation: bubble-rise linear infinite;
    pointer-events: none;
  }
  .float-anim { animation: float-anim 3s ease-in-out infinite; }
  .fade-up    { animation: fade-up .6s cubic-bezier(.2,.8,.2,1) both; }

  .art-card {
    animation: card-float 4s ease-in-out infinite;
    transition: box-shadow .25s, transform .25s;
  }
  .art-card:nth-child(2) { animation-delay: -1.3s; }
  .art-card:nth-child(3) { animation-delay: -2.6s; }
  .art-card:nth-child(4) { animation-delay: -3.9s; }
  .art-card:nth-child(5) { animation-delay: -1.1s; }
  .art-card:nth-child(6) { animation-delay: -2.2s; }
  .art-card:hover {
    box-shadow: 0 24px 60px rgba(20,136,198,0.22) !important;
    transform: translateY(-6px) scale(1.02) !important;
    animation-play-state: paused;
  }
  .art-img {
    transition: transform .35s;
  }
  .art-card:hover .art-img {
    transform: scale(1.06);
  }
</style>

<div class="min-h-screen flex flex-col" style="background: linear-gradient(160deg, #e0f7ff 0%, #b8e4f9 50%, #d0f0ea 100%); position: relative; overflow-x: hidden;">

  <!-- Bubbles -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" style="z-index:0">
    @for (int i = 0; i < 14; i++)
    {
        var bx = Random.Shared.Next(2, 98);
        var bs = Random.Shared.Next(7, 24);
        var bd = Random.Shared.Next(9, 22);
        var bDelay = Random.Shared.Next(0, 12);
        <div class="bubble" style="left:@(bx)%;bottom:-40px;width:@(bs)px;height:@(bs)px;animation-duration:@(bd)s;animation-delay:@(bDelay)s;"></div>
    }
  </div>

  <!-- NAVBAR -->
  <nav style="background: linear-gradient(90deg, #0b2545 0%, #1488c6 100%); box-shadow: 0 2px 20px rgba(11,37,69,0.3);" class="sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
      <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2 text-white font-black text-xl tracking-tight" style="text-decoration:none;">
        <span class="text-2xl">🐟</span>
        <span>Biển Của Chúng Mình</span>
      </a>
      <div class="hidden md:flex items-center gap-1">
        <a asp-controller="Home"   asp-action="Index" class="px-4 py-2 rounded-full text-sm font-bold" style="color:rgba(255,255,255,.85);text-decoration:none;">Trang Chủ</a>
        <a asp-controller="Studio" asp-action="Index" class="px-4 py-2 rounded-full text-sm font-bold" style="color:rgba(255,255,255,.85);text-decoration:none;">Xưởng Vẽ</a>
        <a asp-controller="Ocean"  asp-action="Index" class="px-4 py-2 rounded-full text-sm font-bold" style="color:rgba(255,255,255,.85);text-decoration:none;">Đại Dương</a>
        <a asp-controller="Studio" asp-action="MyArt" class="px-4 py-2 rounded-full text-sm font-bold" style="color:#0b2545;background:#90e0ef;text-decoration:none;">Tác phẩm</a>
      </div>
      <div class="flex items-center gap-3">
        @if (signedIn)
        {
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin" asp-action="Index" class="hidden md:block text-sm font-bold px-4 py-2 rounded-full" style="background:rgba(255,107,107,.3);color:#ffd6d6;text-decoration:none;">⚙️ Admin</a>
            }
            <div class="flex items-center gap-2">
                <span class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-black" style="background:#a8f0e8;color:#0b2545;">@userName.Substring(0,1).ToUpper()</span>
                <span class="text-white text-sm font-bold hidden md:block">@userName</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="text-xs font-semibold px-2" style="color:rgba(255,255,255,.7);">Đăng xuất</button>
                </form>
            </div>
        }
      </div>
    </div>
  </nav>

  <!-- MAIN CONTENT -->
  <main class="flex-1 relative max-w-5xl mx-auto w-full px-4 py-12" style="z-index:1;">

    <!-- Header -->
    <div class="fade-up flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-10">
      <div>
        <p class="text-sm font-black uppercase tracking-widest mb-1" style="color:#4a7fa5;letter-spacing:.12em;">Bộ sưu tập của bạn</p>
        <h1 class="font-black" style="font-size:clamp(28px,5vw,44px);color:#0b2545;letter-spacing:-.03em;line-height:1.1;">
          Tác phẩm của tôi
        </h1>
        <p class="font-semibold mt-2" style="color:#4a7fa5;">
          Xin chào, <span class="font-black" style="color:#1488c6;">@userName</span>! Bạn có <strong>@artList.Count</strong> tác phẩm.
        </p>
      </div>
      <a asp-controller="Studio" asp-action="Index"
         class="flex-shrink-0 px-6 py-3 rounded-2xl font-black text-white text-sm"
         style="background: linear-gradient(135deg, #1488c6, #0b2545); text-decoration:none; box-shadow: 0 6px 20px rgba(20,136,198,0.35);">
        + Vẽ thêm cá
      </a>
    </div>

    @if (TempData["Message"] is string msg)
    {
        <div class="mb-6 px-5 py-3 rounded-2xl font-bold text-sm fade-up" style="background:#f0fdf4;color:#10b981;border:1.5px solid #bbf7d0;">
          ✅ @msg
        </div>
    }

    @if (!artList.Any())
    {
      <!-- Empty state -->
      <div class="fade-up text-center py-24 rounded-3xl"
           style="background:rgba(255,255,255,0.7);border:2.5px dashed rgba(20,136,198,0.25);backdrop-filter:blur(12px);">
        <div class="float-anim text-6xl mb-4">🎨</div>
        <h3 class="text-xl font-black mb-3" style="color:#0b2545;">Bạn chưa có tác phẩm nào</h3>
        <p class="font-semibold mb-6" style="color:#4a7fa5;">Hãy vào Xưởng Vẽ để tô màu con cá đầu tiên!</p>
        <a asp-controller="Studio" asp-action="Index"
           class="inline-block px-8 py-3 rounded-2xl font-black text-white"
           style="background:linear-gradient(135deg,#1488c6,#0b2545);text-decoration:none;box-shadow:0 6px 20px rgba(20,136,198,0.35);">
          🐠 Bắt đầu vẽ
        </a>
      </div>
    }
    else
    {
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        @foreach (var art in artList)
        {
            var statusLabel = art.Status == "Pending"  ? "Chờ duyệt" :
                              art.Status == "Approved" ? "Đã duyệt"  : "Bị từ chối";
            var statusIcon  = art.Status == "Pending"  ? "⏳" :
                              art.Status == "Approved" ? "✅" : "❌";
            var statusColor = art.Status == "Pending"  ? "#f59e0b" :
                              art.Status == "Approved" ? "#10b981"  : "#ef4444";
            var statusBg    = art.Status == "Pending"  ? "#fffbeb" :
                              art.Status == "Approved" ? "#f0fdf4"  : "#fef2f2";
            var title = string.IsNullOrWhiteSpace(art.Title) ? art.Template?.Name ?? "Tác phẩm" : art.Title;

            <div class="art-card flex flex-col rounded-3xl overflow-hidden"
                 style="background:rgba(255,255,255,0.88);backdrop-filter:blur(16px);border:2px solid rgba(20,136,198,0.1);box-shadow:0 8px 32px rgba(11,37,69,0.08);">

              <!-- Image area -->
              <div class="relative overflow-hidden flex items-center justify-center"
                   style="height:190px;background:linear-gradient(135deg,#a8f0e820,#7ec8e330);">
                <div style="position:absolute;width:130px;height:130px;border-radius:50%;background:rgba(255,255,255,.2);top:-25px;right:-25px;"></div>
                <div style="position:absolute;width:70px;height:70px;border-radius:50%;background:rgba(255,255,255,.15);bottom:-15px;left:10px;"></div>
                <img src="@art.ImagePath" alt="@title"
                     class="art-img"
                     style="max-height:150px;max-width:80%;object-fit:contain;position:relative;z-index:1;
                            filter:drop-shadow(0 6px 16px rgba(11,37,69,0.18));" />
              </div>

              <!-- Info area -->
              <div class="flex flex-col p-5 flex-1">
                <div class="flex items-start justify-between gap-2 mb-3">
                  <div>
                    <h3 class="font-black text-base leading-tight" style="color:#0b2545;">@title</h3>
                    <p class="text-xs font-semibold mt-0.5" style="color:#4a7fa5;">
                      @(art.Template?.Type ?? "") • @art.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                    </p>
                  </div>
                  <span class="flex-shrink-0 px-2.5 py-1 rounded-full text-xs font-black"
                        style="background:@statusBg;color:@statusColor;">
                    @statusIcon @statusLabel
                  </span>
                </div>

                <!-- Status action -->
                @if (art.Status == "Pending")
                {
                    <p class="text-xs font-semibold p-3 rounded-xl mt-auto" style="background:#fffbeb;color:#92400e;">
                      Tác phẩm đang chờ duyệt. Hãy kiên nhẫn chút nhé! 🌊
                    </p>
                }
                else if (art.Status == "Approved")
                {
                    <a asp-controller="Ocean" asp-action="Index"
                       class="block text-center text-xs font-black py-2.5 rounded-xl mt-auto"
                       style="background:#f0fdf4;color:#10b981;text-decoration:none;">
                      🌊 Xem cá bơi trong Đại Dương
                    </a>
                }
                else
                {
                    <a asp-controller="Studio" asp-action="Color" asp-route-id="@art.TemplateId"
                       class="block text-center text-xs font-black py-2.5 rounded-xl mt-auto"
                       style="background:#fef2f2;color:#ef4444;text-decoration:none;">
                      🎨 Vẽ lại tác phẩm này
                    </a>
                }
              </div>
            </div>
        }
      </div>
    }
  </main>

  <!-- Wave footer -->
  <div class="relative w-full overflow-hidden" style="height:120px;z-index:1;background:#b8e4f9;">
    <div class="pointer-events-none absolute bottom-0 left-0"
         style="width:200%;height:100%;opacity:0.85;
                background-image:url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 1200 120%22 preserveAspectRatio=%22none%22%3E%3Cpath d=%22M0,40 C150,10 350,70 600,40 C850,10 1050,70 1200,40 L1200,120 L0,120 Z%22 fill=%22%231488c6%22/%3E%3C/svg%3E');
                background-size:50% 100%;animation:wave-anim 8s linear infinite;">
    </div>
    <footer class="absolute bottom-0 left-0 w-full text-center pb-4 text-sm font-bold" style="color:white;z-index:10;">
      🐠 Biển Của Chúng Mình — Nơi mỗi con cá mang một câu chuyện 🌊
    </footer>
  </div>

</div>
