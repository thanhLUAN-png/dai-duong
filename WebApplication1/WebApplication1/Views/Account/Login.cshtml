@model WebApplication1.ViewModels.LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; }
<main class="account-page">
    <div class="account-bubbles" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
    <a class="brand account-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">🐟</span> Biển Của Chúng Mình</a>
    <section class="account-card">
        <div class="account-icon">🐟</div><p class="eyebrow">Chào mừng trở lại</p><h1>Vào xưởng vẽ</h1><p class="account-lead">Đăng nhập để tiếp tục hành trình khám phá đại dương.</p>
        <form method="post"><div asp-validation-summary="ModelOnly" class="validation"></div><label>Email<input asp-for="Email" placeholder="ban@email.com" /></label><label>Mật khẩu<input asp-for="Password" placeholder="••••••••" /></label><button class="primary-button" type="submit">🐟 Đăng nhập</button></form>
        <p>Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a></p>
    </section>
</main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
