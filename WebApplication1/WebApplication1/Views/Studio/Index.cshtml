@model IEnumerable<WebApplication1.Models.CreatureTemplate>
@{ ViewData["Title"] = "Xưởng vẽ"; }
<main class="studio-page"><nav class="studio-nav"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">◒</span> biển của chúng mình</a><div><a asp-action="MyArt">Tác phẩm của tôi</a><form class="inline-form" asp-controller="Account" asp-action="Logout" method="post"><button>Đăng xuất</button></form></div></nav><section class="studio-hero"><p class="eyebrow">Xưởng tô màu</p><h1>Hôm nay bạn muốn<br /><em>vẽ ai?</em></h1><p>Chọn một nét viền và bắt đầu tạo sinh vật mang màu sắc của riêng bạn.</p></section><section class="template-grid">@foreach (var item in Model) { <a class="template-card" asp-action="Color" asp-route-id="@item.Id"><div class="template-art type-@item.Type.ToLowerInvariant()">@(item.Type == "Fish" ? "🐠" : item.Type == "Turtle" ? "🐢" : item.Type == "Starfish" ? "★" : "🪼")</div><p>@item.Type</p><h2>@item.Name</h2><span>Chọn để tô →</span></a> }</section></main>
