@model IEnumerable<WebApplication1.Models.ArtworkSubmission>
@{ ViewData["Title"] = "Tác phẩm của tôi"; }
<main class="studio-page"><nav class="studio-nav"><a class="brand" asp-action="Index"><span class="brand-mark">←</span> xưởng vẽ</a></nav><section class="my-art"><p class="eyebrow">Bộ sưu tập của bạn</p><h1>Tác phẩm của tôi</h1>@if (TempData["Message"] is string message) { <p class="success-message">@message</p> }<div class="art-grid">@foreach (var art in Model) { <article class="art-card"><img src="@art.ImagePath" alt="@art.Title" /><div><span class="status @art.Status.ToLowerInvariant()">@(art.Status == "Pending" ? "Chờ duyệt" : art.Status == "Approved" ? "Đã thả vào biển" : "Cần chỉnh sửa")</span><h2>@(string.IsNullOrWhiteSpace(art.Title) ? art.Template.Name : art.Title)</h2><p>@art.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</p></div></article> }</div>@if (!Model.Any()) { <p class="empty-state">Bạn chưa gửi tác phẩm nào. <a asp-action="Index">Đi vào xưởng vẽ →</a></p> }</section></main>
