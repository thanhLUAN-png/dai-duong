@model WebApplication1.ViewModels.AdminDashboardViewModel
@{ ViewData["Title"] = "Quản trị đại dương"; int? undoId = TempData["UndoOceanId"] is int savedUndoId ? savedUndoId : null; }
<main class="studio-page">
    <nav class="studio-nav"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">◒</span> quản trị đại dương</a><div><a asp-controller="Ocean" asp-action="Index">Xem bể cá</a></div></nav>
    <section class="admin-page">
        <p class="eyebrow">Quản trị</p><h1>Đại dương của cộng đồng</h1><p class="admin-subtitle">Duyệt tác phẩm, quản lý cá trong bể và thùng rác.</p>
        @if (TempData["OceanMessage"] is string message) { <div class="ocean-admin-message"><span>@message</span>@if (undoId.HasValue) { <form asp-action="UndoRemoveFromOcean" method="post"><input type="hidden" name="id" value="@undoId.Value" /><button type="submit">↶ Hoàn tác</button></form> }</div> }
        <div class="admin-tabs" role="tablist"><button type="button" class="active" data-admin-tab="pending">Chờ duyệt <span>@Model.Pending.Count</span></button><button type="button" data-admin-tab="ocean">Đã duyệt <span>@Model.InOcean.Count</span></button><button type="button" data-admin-tab="trash">Thùng rác <span>@Model.Trash.Count</span></button></div>

        <section class="admin-panel active" data-admin-panel="pending"><h2>Tác phẩm chờ duyệt</h2><div class="review-grid">@foreach (var art in Model.Pending) { <article class="review-card"><img src="@art.ImagePath" alt="Tác phẩm của @art.User.DisplayName" /><div><span>@art.User.DisplayName · @art.Template.Name</span><h2>@(art.Title ?? "Chưa đặt tên")</h2><form asp-action="Review" method="post"><input type="hidden" name="id" value="@art.Id" /><input name="note" placeholder="Lời nhắn (không bắt buộc)" /><button name="approve" value="true" class="approve">Duyệt & thả vào biển</button><button name="approve" value="false" class="reject">Từ chối</button></form></div></article> }</div>@if (!Model.Pending.Any()) { <p class="empty-state">Không có tác phẩm nào đang chờ duyệt.</p> }</section>

        <section class="admin-panel" data-admin-panel="ocean"><h2>Cá đã duyệt trong bể</h2><p>Mỗi cá ở đây đang hiển thị trong trang Đại dương.</p><div class="ocean-fish-admin-grid">@foreach (var art in Model.InOcean) { <article class="ocean-fish-admin-card"><img src="@art.ImagePath" alt="@(art.Title ?? art.Template.Name)" /><div><span>@art.User.DisplayName · @art.Template.Name</span><strong>@(art.Title ?? "Cá chưa đặt tên")</strong><form asp-action="RemoveFromOcean" method="post"><input type="hidden" name="id" value="@art.Id" /><button type="submit">Đưa vào thùng rác</button></form></div></article> }</div>@if (!Model.InOcean.Any()) { <p class="empty-state">Chưa có cá nào trong bể.</p> }</section>

        <section class="admin-panel" data-admin-panel="trash"><h2>Thùng rác</h2><p>Cá đưa ra khỏi bể và tác phẩm bị từ chối nằm ở đây.</p><div class="ocean-fish-admin-grid">@foreach (var art in Model.Trash) { <article class="ocean-fish-admin-card"><img src="@art.ImagePath" alt="@(art.Title ?? art.Template.Name)" /><div><span>@art.User.DisplayName · @art.Template.Name</span><strong>@(art.Title ?? "Tác phẩm chưa đặt tên")</strong><em>@(art.Status == "RemovedFromOcean" ? "Đã đưa ra khỏi bể" : "Đã từ chối")</em>@if (art.Status == "RemovedFromOcean") { <form asp-action="UndoRemoveFromOcean" method="post"><input type="hidden" name="id" value="@art.Id" /><button class="restore" type="submit">↶ Khôi phục vào bể</button></form> }</div></article> }</div>@if (!Model.Trash.Any()) { <p class="empty-state">Thùng rác đang trống.</p> }</section>
    </section>
</main>
@section Scripts { <script>document.querySelectorAll('[data-admin-tab]').forEach(button => button.addEventListener('click', () => { document.querySelectorAll('[data-admin-tab]').forEach(item => item.classList.toggle('active', item === button)); document.querySelectorAll('[data-admin-panel]').forEach(panel => panel.classList.toggle('active', panel.dataset.adminPanel === button.dataset.adminTab)); }));</script> }
