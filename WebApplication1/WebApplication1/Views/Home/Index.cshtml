@{
    ViewData["Title"] = "Biển của chúng mình";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var userName = User.Identity?.Name ?? "U";
}

<script src="https://cdn.tailwindcss.com"></script>
<style>
@@keyframes bubble-rise {
  0%   { transform: translateY(0) scale(0.7); opacity: 0; }
  12%  { opacity: 0.75; }
  86%  { opacity: 0.34; }
  100% { transform: translateY(-105vh) translateX(22px) scale(1.2); opacity: 0; }
}
@@keyframes wave-anim {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
.bubble {
  position: absolute;
  border-radius: 50%;
  border: 1px solid rgba(223,255,255,0.6);
  background: radial-gradient(circle at 35% 30%, rgba(255,255,255,0.79), rgba(168,240,232,0.13));
  animation: bubble-rise linear infinite;
  pointer-events: none;
}
.wave-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 200%;
  height: 200px;
  opacity: 0.6;
  background-repeat: repeat-x;
  background-position: bottom;
  background-size: 800px 140px;
  animation: wave-anim 8s linear infinite;
}
</style>

<div class="relative min-h-screen" style="background: linear-gradient(160deg, #e0f7ff 0%, #b8e4f9 52%, #d0f0ea 100%); font-family: 'Nunito', sans-serif;">

  <!-- Navbar -->
  <nav style="background: linear-gradient(90deg, #0b2545 0%, #1488c6 100%); box-shadow: 0 2px 20px rgba(11,37,69,0.3);" class="sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
      <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2 text-white font-black text-xl tracking-tight" style="text-decoration: none;">
        <span style="color: #a8f0e8; font-size: 22px;">◒</span>
        <span>biển của chúng mình</span>
      </a>
      <div class="hidden md:flex items-center gap-1">
        <a asp-controller="Home" asp-action="Index" class="px-4 py-2 rounded-full text-sm font-bold" style="color: #0b2545; background: #90e0ef; text-decoration: none;">Trang Chủ</a>
        <a asp-controller="Studio" asp-action="Index" class="px-4 py-2 rounded-full text-sm font-bold" style="color: rgba(255,255,255,0.85); text-decoration: none;">Xưởng Vẽ</a>
        <a asp-controller="Ocean" asp-action="Index" class="px-4 py-2 rounded-full text-sm font-bold" style="color: rgba(255,255,255,0.85); text-decoration: none;">Đại Dương</a>
      </div>
      <div class="flex items-center gap-3">
        @if (signedIn)
        {
            <a asp-controller="Studio" asp-action="MyArt" class="hidden md:block text-sm font-bold px-4 py-2 rounded-full" style="background: rgba(255,255,255,0.15); color: white; text-decoration: none;">🎨 Tác phẩm của tôi</a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin" asp-action="Index" class="hidden md:block text-sm font-bold px-4 py-2 rounded-full" style="background: rgba(255,200,100,0.25); color: #ffd700; text-decoration: none;">⚡ Admin</a>
            }
            <span class="w-9 h-9 rounded-full flex items-center justify-center font-black text-sm" style="background: linear-gradient(135deg, #a8f0e8, #1488c6); color: #0b2545;">@(userName.Length > 0 ? userName[0].ToString().ToUpper() : "U")</span>
            <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                <button type="submit" class="text-sm font-bold" style="background: none; border: none; color: rgba(255,255,255,0.6); cursor: pointer; padding: 0;">Đăng xuất</button>
            </form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="px-5 py-2 rounded-full text-sm font-black" style="background: #ff6b6b; color: white; text-decoration: none;">Đăng nhập</a>
        }
      </div>
    </div>
  </nav>

  <!-- Ocean Background: Bubbles (fixed, toàn màn hình) -->
  <div class="pointer-events-none fixed inset-0 overflow-hidden" style="z-index: 0;">
    @{
        var bubbleData = new[] {
            new { left="7%",   size="9px",  dur="9s",  delay="0s"  },
            new { left="16%",  size="18px", dur="14s", delay="-6s" },
            new { left="28%",  size="11px", dur="11s", delay="-2s" },
            new { left="39%",  size="7px",  dur="7s",  delay="-4s" },
            new { left="48%",  size="21px", dur="16s", delay="-9s" },
            new { left="60%",  size="10px", dur="10s", delay="-1s" },
            new { left="68%",  size="15px", dur="13s", delay="-8s" },
            new { left="75%",  size="7px",  dur="8s",  delay="-5s" },
            new { left="84%",  size="19px", dur="15s", delay="-10s"},
            new { left="93%",  size="9px",  dur="9s",  delay="-3s" },
            new { left="52%",  size="5px",  dur="6s",  delay="-4s" },
            new { left="33%",  size="14px", dur="12s", delay="-11s"},
        };
    }
    @foreach (var b in bubbleData)
    {
        <div class="bubble" style="left:@b.left; bottom:-35px; width:@b.size; height:@b.size; animation-duration:@b.dur; animation-delay:@b.delay;"></div>
    }
  </div>

  <!-- Hero -->
  <section class="relative z-10 flex flex-col items-center justify-center text-center px-4 pt-20 pb-16">
    <!-- Badge -->
    <div class="inline-flex items-center gap-2 mb-6 px-4 py-2 rounded-full text-sm font-bold" style="background: rgba(20,136,198,0.12); color: #0b2545;">
      🌊 Dự án nghệ thuật cộng đồng
    </div>

    <!-- Title -->
    <h1 class="font-black leading-tight mb-6" style="font-size: clamp(52px, 7vw, 86px); color: #0b2545; line-height: 0.92; letter-spacing: -0.055em;">
      Biển Của<br/>
      <span style="background: linear-gradient(135deg, #1488c6, #7ec8e3, #a8f0e8); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
        Chúng Mình
      </span>
    </h1>

    <!-- Desc -->
    <p class="text-lg md:text-xl max-w-lg mb-10 leading-relaxed font-semibold" style="color: #1a3a5c;">
      Vẽ con cá của riêng bạn, thả nó vào đại dương chung, và cùng nhau tạo nên một bể cá sống động nhất thế giới 🐠
    </p>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row gap-4">
      <a asp-controller="Studio" asp-action="Index"
         class="px-8 py-4 rounded-2xl text-lg font-black shadow-lg transition-transform hover:scale-105"
         style="background: linear-gradient(135deg, #1488c6, #0b2545); color: white; text-decoration: none;">
        🎨 Bắt đầu vẽ ngay
      </a>
      <a asp-controller="Ocean" asp-action="Index"
         class="px-8 py-4 rounded-2xl text-lg font-black shadow-lg transition-transform hover:scale-105"
         style="background: linear-gradient(135deg, #a8f0e8, #7ec8e3); color: #0b2545; text-decoration: none;">
        🌊 Xem Đại Dương
      </a>
    </div>

    <!-- Stats -->
    <div class="flex gap-8 mt-12">
      @{
          var approvedCount = ViewBag.ApprovedCount ?? 1;
          var templateCount = ViewBag.TemplateCount ?? 5;
          var artistCount = ViewBag.ArtistCount ?? 5;
      }
      <div class="text-center">
        <div class="text-3xl font-black" style="color: #1488c6;">@approvedCount</div>
        <div class="text-sm font-bold" style="color: #4a7fa5;">Cá đang bơi</div>
      </div>
      <div class="text-center">
        <div class="text-3xl font-black" style="color: #1488c6;">@templateCount</div>
        <div class="text-sm font-bold" style="color: #4a7fa5;">Mẫu sinh vật</div>
      </div>
      <div class="text-center">
        <div class="text-3xl font-black" style="color: #1488c6;">@artistCount</div>
        <div class="text-sm font-bold" style="color: #4a7fa5;">Nghệ sĩ tham gia</div>
      </div>
    </div>
  </section>

  <!-- Fish Template Strip -->
  <section class="relative z-10 py-12 overflow-hidden">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-center text-2xl font-black mb-8" style="color: #0b2545;">
        🎨 Chọn sinh vật yêu thích để bắt đầu
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
        @{
            var fishTemplates = new[] {
                new { Id="clownfish",  Name="Cá Hề",         Emoji="🐠", Color="#ffdcdc" },
                new { Id="angelfish",  Name="Cá Thiên Thần", Emoji="🐡", Color="#fff2cc" },
                new { Id="pufferfish", Name="Cá Nóc",        Emoji="🐡", Color="#f2f2f2" },
                new { Id="seahorse",   Name="Cá Ngựa",       Emoji="🦄", Color="#b8f2e6" },
                new { Id="jellyfish",  Name="Con Sứa",       Emoji="🪼", Color="#cdb4db" },
            };
        }
        @foreach (var fish in fishTemplates)
        {
            <a asp-controller="Studio" asp-action="Index"
               class="group flex flex-col items-center gap-3 p-4 rounded-2xl transition-all hover:scale-105"
               style="background: rgba(255,255,255,0.7); backdrop-filter: blur(12px); border: 2px solid rgba(20,136,198,0.15); text-decoration: none;">
              <span class="w-full flex justify-center items-center rounded-xl" style="height: 100px; background: color-mix(in srgb, @fish.Color, white 78%);">
                <img src="~/images/templates/fish-template.png" style="height:70px; object-fit:contain;" alt="@fish.Name" />
              </span>
              <span class="text-sm font-black" style="color: #0b2545">@fish.Emoji @fish.Name</span>
            </a>
        }
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="relative z-10 py-16 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-center text-3xl font-black mb-12" style="color: #0b2545;">
        Cách chơi đơn giản lắm! 🐟
      </h2>
      <div class="grid md:grid-cols-3 gap-6">
        @{
            var steps = new[] {
                new { Step="01", Icon="🎨", Title="Chọn mẫu & Tô màu",  Desc="Chọn loài sinh vật biển yêu thích. Chọn màu sắc và tô từng bộ phận theo ý thích." },
                new { Step="02", Icon="📬", Title="Gửi tác phẩm",        Desc="Đặt tên cho con cá và gửi tác phẩm. Chờ Admin duyệt rồi cá sẽ được thả vào biển." },
                new { Step="03", Icon="🌊", Title="Thả vào Đại Dương",   Desc="Con cá của bạn sẽ bơi trong đại dương cùng tất cả mọi người. Mọi người đều có thể ngắm!" },
            };
        }
        @foreach (var s in steps)
        {
            <div class="p-6 rounded-3xl"
                 style="background: rgba(255,255,255,0.7); backdrop-filter: blur(12px); border: 2px solid rgba(20,136,198,0.12);">
              <div class="text-4xl mb-3">@s.Icon</div>
              <h3 class="font-black text-lg mb-2" style="color: #0b2545;">@s.Title</h3>
              <p class="text-sm leading-relaxed font-semibold" style="color: #4a7fa5;">@s.Desc</p>
            </div>
        }
      </div>
    </div>
  </section>

  <!-- CTA (chỉ hiện khi chưa đăng nhập) -->
  @if (!signedIn)
  {
      <section class="relative z-10 py-16 px-4 text-center">
        <div class="max-w-2xl mx-auto p-10 rounded-3xl" style="background: linear-gradient(135deg, #0b2545, #1488c6);">
          <div class="text-5xl mb-4">🐠</div>
          <h2 class="text-3xl font-black text-white mb-4">Sẵn sàng thả cá vào biển?</h2>
          <p class="font-semibold mb-8" style="color: rgba(255,255,255,0.8);">Đăng ký miễn phí, vẽ ngay, thả cá của bạn cùng cộng đồng.</p>
          <div class="flex gap-4 justify-center">
            <a asp-controller="Account" asp-action="Register"
               class="px-8 py-3 rounded-2xl font-black text-lg"
               style="background: #ff6b6b; color: white; text-decoration: none;">
              Tạo tài khoản miễn phí
            </a>
            <a asp-controller="Account" asp-action="Login"
               class="px-8 py-3 rounded-2xl font-black text-lg"
               style="background: rgba(255,255,255,0.15); color: white; text-decoration: none;">
              Đăng nhập
            </a>
          </div>
        </div>
      </section>
  }

  <!-- Sóng nước + Footer -->
  <div class="relative w-full overflow-hidden mt-8" style="height: 180px;">
    <!-- Sóng cuộn ngang -->
    <div class="pointer-events-none absolute bottom-0 left-0" 
         style="width: 200%; height: 100%; opacity: 0.85; 
                background-image: url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 1200 120%22 preserveAspectRatio=%22none%22%3E%3Cpath d=%22M0,40 C150,10 350,70 600,40 C850,10 1050,70 1200,40 L1200,120 L0,120 Z%22 fill=%22%231488c6%22/%3E%3C/svg%3E'); 
                background-size: 50% 100%; animation: wave-anim 8s linear infinite;">
    </div>
    
    <!-- Dòng text footer nằm đè lên phần thân đặc của sóng -->
    <footer class="absolute bottom-0 left-0 w-full text-center pb-6 text-sm font-bold" style="color: white; z-index: 10;">
      🐠 Biển Của Chúng Mình — Nơi mỗi con cá mang một câu chuyện 🌊
    </footer>
  </div>

</div>
