@{
    ViewData["Title"] = "Đại dương cộng đồng";
}

<main class="ocean-page">
    <nav class="ocean-nav" aria-label="Điều hướng chính">
        <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">◒</span> biển của chúng mình</a>
        <div class="nav-links">
            <a asp-controller="Ocean" asp-action="Index">Đại dương sống</a>
            <a href="#how-it-works">Cách tham gia</a>
            @if (User.Identity?.IsAuthenticated == true) { <a class="nav-action" asp-controller="Studio" asp-action="Index">Vào xưởng vẽ</a> } else { <a class="nav-action" asp-controller="Account" asp-action="Login">Đăng nhập</a> }
        </div>
    </nav>

    <section class="hero" id="explore">
        <div class="sun-glow"></div>
        <div class="surface-wave wave-one"></div>
        <div class="surface-wave wave-two"></div>
        <div class="bubble bubble-a"></div><div class="bubble bubble-b"></div><div class="bubble bubble-c"></div>
        <div class="hero-copy">
            <p class="eyebrow">Một thế giới được vẽ bởi cộng đồng</p>
            <h1>Thả màu sắc<br /><em>vào đại dương.</em></h1>
            <p class="hero-description">Chọn một sinh vật biển, tô màu theo cách của bạn và gửi nó vào vùng nước chung. Khi được duyệt, tác phẩm sẽ bắt đầu chuyến bơi của riêng mình.</p>
            <div class="hero-actions" id="join">
                <a class="primary-button" asp-controller="Studio" asp-action="Index">Tạo sinh vật của bạn <span>→</span></a>
                <a class="text-button" asp-controller="Ocean" asp-action="Index">Ngắm đại dương <span>→</span></a>
            </div>
        </div>
        <div class="hero-label label-left"><span></span> Đáy biển</div>
        <div class="hero-label label-right"><span></span> Mặt nước</div>
    </section>

    <section class="living-ocean" id="ocean" aria-label="Đại dương đang sống">
        <div class="ocean-intro">
            <p class="eyebrow">Đang trôi trong làn nước</p>
            <h2>Mỗi nét vẽ<br />là một cư dân mới.</h2>
            <p>Đây là nơi các tác phẩm đã được duyệt gặp nhau, bơi chậm rãi và cùng tạo nên một rạn san hô không ngừng lớn lên.</p>
        </div>
        <div class="creature-stage" aria-hidden="true">
            <div class="ray creature"><span class="ray-tail"></span></div>
            <div class="fish fish-orange creature"><span class="fish-eye"></span><span class="fish-tail"></span></div>
            <div class="fish fish-blue creature"><span class="fish-eye"></span><span class="fish-tail"></span></div>
            <div class="turtle creature"><span class="shell"></span><span class="fin fin-left"></span><span class="fin fin-right"></span><span class="head"></span></div>
            <div class="coral coral-one"></div><div class="coral coral-two"></div><div class="seaweed seaweed-one"></div><div class="seaweed seaweed-two"></div>
        </div>
        <div class="ocean-count"><strong>0</strong><span>sinh vật đang chờ<br />nét màu đầu tiên</span></div>
    </section>

    <section class="how-it-works" id="how-it-works">
        <div class="section-heading"><p class="eyebrow">Cùng tạo nên vùng biển này</p><h2>Ba bước thật đơn giản.</h2></div>
        <div class="steps">
            <article><span class="step-number">01</span><div class="step-icon">✦</div><h3>Chọn bạn đồng hành</h3><p>Chọn mẫu cá, rùa, sao biển hoặc những sinh vật nhỏ xinh do chúng mình chuẩn bị.</p></article>
            <article><span class="step-number">02</span><div class="step-icon">◌</div><h3>Tô theo ý bạn</h3><p>Dùng cọ, bảng màu, tẩy và hoàn tác để biến nét viền thành tác phẩm thật riêng.</p></article>
            <article><span class="step-number">03</span><div class="step-icon">⌁</div><h3>Thả vào biển</h3><p>Gửi tranh để duyệt. Khi sẵn sàng, sinh vật của bạn sẽ xuất hiện trong đại dương.</p></article>
        </div>
    </section>

    <section class="closing-cta"><p class="eyebrow">Đại dương đang đợi</p><h2>Bạn sẽ thả sinh vật<br /><em>nào xuống biển?</em></h2><a class="primary-button light-button" asp-controller="Studio" asp-action="Index">Bắt đầu hành trình <span>→</span></a></section>
</main>
